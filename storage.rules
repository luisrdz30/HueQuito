rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Lectura pública de imágenes (para ver huecas, platos y fotos en la app)
      allow read: if true;
      
      // Subida de imágenes protegida: solo usuarios autenticados e imágenes válidas (< 10MB)
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
